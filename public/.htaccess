# Argent Lune — static hosting cache rules (Apache / LiteSpeed, e.g. Hostinger Web Hosting)
#
# Why this file exists: the site is a single-page app whose JS/CSS are content-hashed.
# If index.html is cached by the browser or by the host, visitors keep loading the
# previous bundle — new navigation entries and pages appear to be "missing" after a
# deploy. index.html must always be revalidated; hashed assets can be cached forever.

<IfModule mod_headers.c>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  <FilesMatch "\.(js|css|woff2?|ttf|otf|jpg|jpeg|png|webp|avif|svg|mp4|webm|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
